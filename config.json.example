    "device_id": "YOUR_DEVICE_ID",
    "devices": [
        "DEVICE_ID_1",
        "DEVICE_ID_2",
        "DEVICE_ID_3"
    ],
    "local_devices": [
        {
            "id": "DEVICE_ID_1",
            "name": "Sensor 1",
            "ip": "192.168.1.100",
            "local_key": "LOCAL_KEY_1",
            "version": "3.3",
            "_comment": "Set cloud_only for battery sensors that sleep: they never answer locally, so probing them wastes a full network scan per update.",
            "cloud_only": true
        },
        {
            "id": "DEVICE_ID_2",
            "name": "Sensor 2",
            "ip": "192.168.1.101",
            "local_key": "LOCAL_KEY_2",
            "version": "3.3",
            "cloud_only": true
        },
        {
            "id": "DEVICE_ID_3",
            "name": "Sensor 3",
            "ip": "192.168.1.102",
            "local_key": "LOCAL_KEY_3",
            "version": "3.3",
            "cloud_only": true
        }
    ],
    "_comment_local_sockets": "Plural. The collector and the widget both read local_sockets; a lone local_socket object is only still honoured as a legacy fallback by the widget, and the collector ignores it entirely.",
    "local_sockets": [
        {
            "id": "SOCKET_DEVICE_ID_1",
            "name": "Smart Plug 1",
            "ip": "192.168.1.103",
            "local_key": "SOCKET_LOCAL_KEY_1",
            "version": "3.3"
        },
        {
            "id": "SOCKET_DEVICE_ID_2",
            "name": "Smart Plug 2",
            "ip": "192.168.1.104",
            "local_key": "SOCKET_LOCAL_KEY_2",
            "version": "3.3"
        }
    ],

    "_comment_history_token": "Shared secret for the history API. Generate with: ./venv/bin/python3 -c \"import secrets; print(secrets.token_urlsafe(32))\" and put the SAME value here on the server and on the desktop. Never commit a real one.",
    "history_token": "GENERATE_A_TOKEN"
}
